{
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/vcsky/:path*", "destination": "/api/proxy?target=sky&path=:path*" },
    { "source": "/vcbr/:path*", "destination": "/api/proxy?target=br&path=:path*" }
  ]
}
