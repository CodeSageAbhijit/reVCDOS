{
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/vcsky/:path*", "destination": "https://cdn.dos.zone/vcsky/:path*" },
    { "source": "/vcbr/:path*", "destination": "https://br.cdn.dos.zone/vcsky/:path*" }
  ]
}
